{
  "name": "r-board",
  "version": "1.1.3",
  "description": "Configurable board views for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "build:css": "node build-css.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "deploy": "node esbuild.config.mjs production && cp main.js manifest.json styles.css \"../test/Test Plugin/.obsidian/plugins/r-board/\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "echarts": "^5.6.0",
    "immer": "^11.1.21",
    "lucide-react": "^1.74.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "happy-dom": "^20.14.6",
    "lucide-static": "^1.70.0",
    "obsidian": "latest",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
